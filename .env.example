# FoodFlow DBMS — copy to .env and fill in real values. Never commit .env.
# The values below are LOCAL-DEV ONLY defaults. They match docker-compose.yml
# (MySQL user foodflow / database food_ordering_db) so the documented
# local setup works out of the box. Change AUTH_SECRET (and the DB password)
# before any production use.
DATABASE_URL="mysql://foodflow:foodflow_dev_2026@localhost:3306/food_ordering_db"
# Dev-only JWT secret (64 hex chars, generated with: openssl rand -hex 32).
# Replace with your own random secret for production.
AUTH_SECRET="853dc33f18924842b0e4026c61588bd89c709ddcc0492886772fa148afcf9a29"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional — FoodFlow Intelligence (Gemini). Leave blank to run without AI.
GEMINI_API_KEY=""
